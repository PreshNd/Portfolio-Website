// Cloudflare Workers config: serves the built Astro site (dist/) as static assets.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pcn-portfolio",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": true
}
