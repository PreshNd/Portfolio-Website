---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Sky from '../components/Sky.astro';

interface Props {
  title?: string;
  description?: string;
  /** "night" for story pages, "day" for long reading (case studies). */
  surface?: 'night' | 'day';
  noindex?: boolean;
}

const {
  title,
  description = 'Chinenye Ndigwe is a technical product manager. She sees a product the way the whole system around it sees it: the customer, and the teams who run it.',
  surface = 'night',
  noindex = false,
} = Astro.props;

const siteName = 'Chinenye Ndigwe';
const fullTitle = title ? `${title} · ${siteName}` : `${siteName} · Technical Product Manager`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Chinenye Ndigwe',
  alternateName: 'Chi Ndigwe',
  jobTitle: 'Technical Product Manager',
  url: 'https://pcndigwe.site',
  address: { '@type': 'PostalAddress', addressLocality: 'Lagos', addressCountry: 'NG' },
  alumniOf: 'Nnamdi Azikiwe University',
};
---

<!doctype html>
<html lang="en" class="no-js" data-surface={surface} data-mode="dream">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={surface === 'day' ? '#FEE6FE' : '#22022B'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.replace('no-js', 'js');
        var mode = 'dream';
        try {
          mode = localStorage.getItem('pcn-mode') || 'dream';
        } catch (e) {}
        root.dataset.mode = mode === 'read' ? 'read' : 'dream';
        // sky preview for review: ?sky=milkyway|bloom|spiral|whisper sticks for the tab
        try {
          var sky = new URLSearchParams(location.search).get('sky');
          if (sky) sessionStorage.setItem('pcn-sky', sky);
          sky = sky || sessionStorage.getItem('pcn-sky');
          if (sky) root.dataset.sky = sky;
        } catch (e) {}
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Sky />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
