---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { posts } from '../data/writing';
import { site } from '../data/site';
---

<Base title="Building the Gaps" description="Building the Gaps: a LinkedIn series by Chinenye Ndigwe.">
  <PageIntro kicker="Writing" title="Building the Gaps" id="writing" tone="purple">
    <p>My series on LinkedIn. Each post opens on LinkedIn, where the conversation happens.</p>
  </PageIntro>

  <section class="wrap section">
    {
      posts.length > 0 && (
        <ul class="cards" role="list">
          {posts.map((p, i) => (
            <li data-reveal style={`--reveal-i:${i % 3}`}>
              <a class="card post" href={p.url} target="_blank" rel="noopener">
                <span class="meta">Building the Gaps · {String(i + 1).padStart(2, '0')}</span>
                <h3>{p.title}</h3>
                <p>{p.excerpt}</p>
                <span class="read mono">Read on LinkedIn ↗</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {
      site.linkedin && (
        <p class="cta-row">
          <a class="btn" href={site.linkedin} target="_blank" rel="noopener">
            Follow me on LinkedIn <span aria-hidden="true">↗</span>
          </a>
        </p>
      )
    }
  </section>
</Base>

<style>
  .post {
    text-decoration: none;
    transition: border-color var(--dur-med) ease;
  }
  .post:hover,
  .post:focus-visible {
    border-color: var(--border-strong);
  }
  .read {
    font-size: 0.72rem;
    color: var(--accent);
  }
</style>
