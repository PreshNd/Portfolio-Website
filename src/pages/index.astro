---
import Base from '../layouts/Base.astro';

const doors = [
  {
    href: '/journey',
    kicker: 'hiring a PM',
    title: 'Walk my journey',
    body: 'From web builder to product. What each stage taught me, and how I use it now.',
  },
  {
    href: '/web',
    kicker: 'need a website',
    title: 'See sites I built',
    body: 'WordPress builds, some on custom themes. Can I build yours? Probably.',
  },
  {
    href: '/about',
    kicker: 'just curious',
    title: 'Meet Chi',
    body: 'Who I am outside the roadmap, and the work I do beyond work.',
  },
];
---

<Base>
  <section class="hero wrap">
    <p class="eyebrow" data-reveal>// technical product manager · lagos</p>
    <h1 data-reveal style="--reveal-i:1">
      Chinenye Ndigwe<span class="dot">.</span>
    </h1>
    <p class="tagline" data-reveal style="--reveal-i:2">Building Everyday Buddies.</p>
    <p class="lede" data-reveal style="--reveal-i:3">
      I see a product the way the whole system around it sees it. The customer, yes. And the
      people who build it, sell it, support it and live with it every day.
    </p>
  </section>

  <section class="fork wrap" aria-labelledby="fork-title">
    <h2 id="fork-title" class="fork-title" data-reveal>What brings you here?</h2>
    <ul class="doors" role="list">
      {
        doors.map((d, i) => (
          <li data-reveal style={`--reveal-i:${i + 1}`}>
            <a class="door" href={d.href}>
              <span class="mono kicker">{d.kicker}</span>
              <span class="door-title">
                {d.title} <span class="arrow" aria-hidden="true">→</span>
              </span>
              <span class="door-body">{d.body}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .hero {
    min-height: 78svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--space-9) var(--space-8);
  }
  .hero h1 {
    margin-top: var(--space-4);
  }
  .dot {
    color: var(--accent-warm);
  }
  .tagline {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 500;
    letter-spacing: -0.02em;
    background: linear-gradient(95deg, var(--purple-300), var(--peach-500) 70%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    width: fit-content;
  }
  .lede {
    margin-top: var(--space-5);
    max-width: 52ch;
    font-size: var(--step-1);
    color: var(--text-muted);
  }

  .fork {
    padding-block: var(--space-7);
  }
  .fork-title {
    font-size: var(--step-3);
  }
  .doors {
    list-style: none;
    padding: 0;
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .door {
    position: relative;
    display: grid;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-6) var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-l);
    background: var(--surface);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: var(--text);
    text-decoration: none;
    overflow: hidden;
    transition:
      border-color var(--dur-med) ease,
      transform var(--dur-med) var(--ease-out);
  }
  /* soft glow follows the pointer (set in script below) */
  .door::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      320px circle at var(--mx, 50%) var(--my, 120%),
      color-mix(in oklab, var(--purple-300) 16%, transparent),
      transparent 60%
    );
    opacity: 0;
    transition: opacity var(--dur-med) ease;
  }
  .door:hover,
  .door:focus-visible {
    border-color: var(--border-strong);
    transform: translateY(-4px);
  }
  .door:hover::before,
  .door:focus-visible::before {
    opacity: 1;
  }
  .kicker {
    color: var(--accent-warm);
  }
  .door-title {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    color: var(--heading);
    letter-spacing: -0.02em;
  }
  .arrow {
    display: inline-block;
    color: var(--accent);
    transition: transform var(--dur-med) var(--ease-out);
  }
  .door:hover .arrow {
    transform: translateX(6px);
  }
  .door-body {
    color: var(--text-muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .door:hover,
    .door:focus-visible {
      transform: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.door').forEach((el) => {
    el.addEventListener('pointermove', (e) => {
      const r = el.getBoundingClientRect();
      el.style.setProperty('--mx', `${e.clientX - r.left}px`);
      el.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });
</script>
