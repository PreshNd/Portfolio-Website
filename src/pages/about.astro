---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import portrait from '../assets/photos/chi-warm-blazer.jpg';
import { skillGroups, tools } from '../data/skills';

const lenses = [
  ['Web development', 'A clear sense of what is genuinely buildable, so I scope honestly and can prototype ideas myself.'],
  ['CRM', 'A focus on what happens after the sale, so that no customer falls through the cracks.'],
  ['Marketing', 'An understanding of how a product is discovered, sold and measured.'],
  ['CMS and platforms', 'Empathy for the people who run a tool and live with it every day.'],
  ['Product', 'The discipline to bring all of this into one decision and to own the outcome.'],
];
---

<Base
  title="About"
  description="Chinenye (Chi) Ndigwe is a technical product manager who began as a web developer and grew through CRM, marketing and CMS into product."
>
  <PageIntro kicker="About" title="Hi, I'm Chi." id="about" tone="peach">
    <p>
      I am a technical product manager. I began my career as a web developer and worked across CRM,
      marketing and CMS before moving into product management.
    </p>
  </PageIntro>

  <section class="wrap section about">
    <figure class="photo" data-reveal>
      <Image
        src={portrait}
        alt="Chi Ndigwe in a black blazer, smiling, in warm studio light"
        widths={[360, 560, 720]}
        sizes="(max-width: 52rem) 80vw, 360px"
      />
    </figure>
    <div class="prose story" data-reveal style="--reveal-i:1">
      <h2 class="section-title">How I think</h2>
      <p>
        I look at a product the way the whole system around it experiences it. That includes the
        customer, and equally the teams connected to the product: operations, finance, support and
        marketing.
      </p>
      <p>
        That is what "technical" means to me. I understand the technology well enough to scope
        honestly and speak with engineers in their own language, and I understand the people well
        enough to ensure the product works for everyone who relies on it.
      </p>
      <p>
        I call the products I build <em>everyday buddies</em>: products that serve the customer and
        the people who run them equally well.
      </p>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="section-title"><span class="mono">01</span> The lenses I bring</h2>
    <p class="section-lede">Each role I have held taught me to see a product from a different side.</p>
    <ul class="cards" role="list">
      {
        lenses.map(([name, line], i) => (
          <li class="card" data-reveal style={`--reveal-i:${i % 3}`}>
            <h3>{name}</h3>
            <p>{line}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap section" id="skills">
    <h2 class="section-title"><span class="mono">02</span> Skills and tools</h2>
    <p class="section-lede">The skills and tools I rely on, from discovery through to launch.</p>
    <div class="skills">
      {
        skillGroups.map((g, i) => (
          <div class="card" data-reveal style={`--reveal-i:${i % 3}`}>
            <h3>{g.name}</h3>
            <ul class="tags" role="list">
              {g.skills.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          </div>
        ))
      }
      <div class="card tools" data-reveal>
        <h3>Tools</h3>
        <ul class="tags" role="list">
          {tools.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="section-title"><span class="mono">03</span> Right now</h2>
    <div class="prose now">
      <p>
        I am open to product management roles, with a particular interest in payments and fintech. I
        also take on freelance and consulting work, including websites, platform and CMS advice, and
        project management.
      </p>
      <p>
        Next year, I am taking a payments product management course covering API integrations and
        payment gateways, to formalise what I have learned in practice.
      </p>
      <p>
        Outside my day job, I lead volunteer projects and serve in my church's leadership. You can
        read more in <a href="/beyond">Beyond Work</a>.
      </p>
    </div>
    <dl class="edu">
      <div>
        <dt class="mono">Education</dt>
        <dd>BSc Computer Science, Nnamdi Azikiwe University, 2018</dd>
      </div>
      <div>
        <dt class="mono">Certifications</dt>
        <dd>Product Management, Utiva Product School, 2025</dd>
        <dd>Google Analytics, Google, 2023</dd>
        <dd>Product Design bootcamp (6 months), Genesys Tech Hub, 2022</dd>
      </div>
    </dl>
    <p class="cta-row">
      <a class="btn" href="/journey">Walk my journey <span aria-hidden="true">→</span></a>
      <a class="btn btn--ghost" href="/contact">Say hello</a>
    </p>
  </section>
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }
  .photo {
    margin: 0;
  }
  .photo img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-l);
  }
  .skills {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-6);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
  }
  .story p,
  .now p {
    color: var(--text-muted);
    font-size: var(--step-0);
  }
  .now {
    margin-top: var(--space-5);
  }
  .now a {
    color: var(--accent);
  }
  .edu {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }
  .edu dt {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .edu dd {
    margin: var(--space-1) 0 0;
    color: var(--heading);
  }
  @media (max-width: 52rem) {
    .about {
      grid-template-columns: 1fr;
    }
    .photo {
      max-width: 320px;
    }
  }
</style>
