---
/**
 * Interim wordmark. Chi is redesigning the PCN logo; when the file arrives,
 * swap this component's markup for the SVG and everything updates.
 */
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<span class:list={['logo', { compact }]}>
  <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
    <circle cx="16" cy="16" r="12" fill="none" stroke="currentColor" stroke-width="2.2"></circle>
    <circle cx="16" cy="16" r="6.5" fill="none" stroke="currentColor" stroke-width="1.2" opacity=".55"></circle>
    <circle cx="19" cy="13" r="3" class="moon"></circle>
  </svg>
  <span class="word">
    <span class="name">PCN</span>
    {!compact && <span class="tag">building everyday buddies</span>}
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--heading);
  }
  .mark {
    width: 30px;
    height: 30px;
    color: var(--accent);
    transition: transform var(--dur-med) var(--ease-out);
  }
  /* the lens: a ring, an inner ring, and a warm core that drifts on hover */
  .moon {
    fill: var(--accent-warm);
    transform-origin: 16px 16px;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  :global(a:hover) > .logo .moon {
    transform: rotate(180deg);
  }
  .word {
    display: grid;
    line-height: 1;
  }
  .name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: 0.02em;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-top: 0.3rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .moon {
      transition: none;
    }
  }
</style>
