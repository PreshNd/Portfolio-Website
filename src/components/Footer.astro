---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap grid">
    <div class="brand">
      <Logo />
      <p class="line">
        Product manager in Lagos. I build products that work for the customer and for the teams who
        run them.
      </p>
    </div>

    <nav aria-label="Footer" class="cols">
      <div>
        <p class="eyebrow">explore</p>
        <ul role="list">
          <li><a href="/journey">The Journey</a></li>
          <li><a href="/work">Work</a></li>
          <li><a href="/web">Web Work</a></li>
          <li><a href="/beyond">Beyond Work</a></li>
        </ul>
      </div>
      <div>
        <p class="eyebrow">more</p>
        <ul role="list">
          <li><a href="/writing">Building the Gaps</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/cv">CV</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="wrap base mono">
    <span>© {year} Chinenye Ndigwe</span>
    <span class="coords" aria-label="Lagos, Nigeria">6.5244° N, 3.3792° E</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-10);
    padding-block: var(--space-8) var(--space-6);
    border-top: 1px solid var(--border);
  }
  .grid {
    display: grid;
    gap: var(--space-7);
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
  }
  .line {
    margin-top: var(--space-4);
    max-width: 34ch;
    color: var(--text-muted);
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }
  ul {
    list-style: none;
    padding: 0;
    margin-top: var(--space-3);
    display: grid;
    gap: var(--space-2);
  }
  ul a {
    color: var(--text);
    text-decoration: none;
  }
  ul a:hover {
    color: var(--accent);
  }
  .base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-8);
    color: var(--text-muted);
  }
  @media (max-width: 44rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
