---
/**
 * "How I build": Chi's loop from her LinkedIn banner, redrawn in the site's
 * orbit language. Six nodes on a dotted path, and a warm loop from Learn
 * back to Problem. Nodes light up in order as the section scrolls in.
 */
import '@fontsource/instrument-serif/latin-400-italic.css';

const steps = [
  { label: 'Problem', icon: 'problem' },
  { label: 'Insight', icon: 'insight' },
  { label: 'Design', icon: 'design' },
  { label: 'Build', icon: 'build' },
  { label: 'Impact', icon: 'impact' },
  { label: 'Learn', icon: 'learn' },
];
---

<section class="how wrap" aria-labelledby="how-title">
  <div class="head" data-reveal>
    <h2 id="how-title" class="kicker mono">How I build</h2>
    <span class="rule" aria-hidden="true"></span>
  </div>

  <div class="loop-wrap">
    <ol class="steps" role="list">
      {
        steps.map((s, i) => (
          <li class:list={['step', { warm: s.icon === 'learn' }]} data-reveal style={`--reveal-i:${i}`}>
            <span class="node" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                {s.icon === 'problem' && (
                  <>
                    <path d="M8.2 8.6a3.9 3.9 0 1 1 5.6 3.5c-1.1.6-1.8 1.5-1.8 2.7v.9" />
                    <circle class="fill" cx="12" cy="19.3" r="1.25" />
                  </>
                )}
                {s.icon === 'insight' && (
                  <>
                    <circle cx="10.5" cy="10.5" r="6" />
                    <path d="M15 15l5 5" />
                  </>
                )}
                {s.icon === 'design' && (
                  <>
                    <rect x="3" y="4.5" width="18" height="15" rx="2" />
                    <path d="M3 8.5h18M6.5 12h4.5v4.5H6.5zM14 12h3.5M14 15h3.5" />
                  </>
                )}
                {s.icon === 'build' && <path d="M8 7l-5 5 5 5M16 7l5 5-5 5M14 5l-4 14" />}
                {s.icon === 'impact' && (
                  <>
                    <rect class="fill" x="4" y="14" width="4" height="6" rx="1" />
                    <rect class="fill" x="10" y="10" width="4" height="10" rx="1" />
                    <rect class="fill" x="16" y="5" width="4" height="15" rx="1" />
                  </>
                )}
                {s.icon === 'learn' && (
                  <path d="M19.5 12a7.5 7.5 0 0 1-13.4 4.6M4.5 12a7.5 7.5 0 0 1 13.4-4.6M18.2 3.6v4h-4M5.8 20.4v-4h4" />
                )}
              </svg>
            </span>
            <span class="label mono">{s.label}</span>
          </li>
        ))
      }
    </ol>
    <svg class="loop" aria-hidden="true" data-reveal style="--reveal-i:6">
      <defs>
        <marker id="how-arrow" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M1 1l4 4-4 4" />
        </marker>
      </defs>
      <path class="loop-path" marker-end="url(#how-arrow)" />
    </svg>
    <p class="visually-hidden">After Learn, the loop goes back to Problem.</p>
  </div>

  <p class="motto" data-reveal style="--reveal-i:7">
    Intuitive. <span class="warm-word">Reliable.</span> Human.
  </p>
</section>

<style>
  .how {
    --node: 72px;
    padding-block: var(--space-9) var(--space-8);
    text-align: center;
  }
  .head {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
  }
  .kicker {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--heading);
  }
  .rule {
    width: 64px;
    height: 1.5px;
    background: linear-gradient(90deg, var(--accent), transparent);
  }

  .loop-wrap {
    position: relative;
    max-width: 62rem;
    margin: var(--space-8) auto 0;
    padding-bottom: var(--space-8);
  }
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }
  .step {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-4);
  }
  /* dotted connector to the next node */
  .step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: calc(var(--node) / 2);
    left: calc(50% + var(--node) / 2 + 8px);
    right: calc(-50% + var(--node) / 2 + 8px);
    border-top: 2px dotted color-mix(in oklab, var(--accent) 55%, transparent);
  }
  .node {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--node);
    height: var(--node);
    border-radius: 50%;
    background: var(--surface-solid);
    border: 1.5px solid var(--border-strong);
    color: var(--accent);
    transition:
      transform var(--dur-med) var(--ease-out),
      box-shadow var(--dur-med) var(--ease-out),
      border-color var(--dur-med) ease;
  }
  .step:hover .node {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: 0 0 0 6px color-mix(in oklab, var(--accent) 12%, transparent);
  }
  .node svg {
    width: 28px;
    height: 28px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .node .fill {
    fill: currentColor;
    stroke: none;
  }
  .label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--heading);
  }
  .label::after {
    content: '';
    display: block;
    width: 22px;
    height: 1.5px;
    margin: 0.7em auto 0;
    background: var(--accent);
    opacity: 0.6;
  }
  .warm .node {
    color: var(--accent-warm);
    border-color: color-mix(in oklab, var(--accent-warm) 65%, transparent);
  }
  .warm .label::after {
    background: var(--accent-warm);
  }

  /* the loop back, Learn → Problem: one path measured from the real nodes */
  .loop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .loop-path {
    fill: none;
    stroke: color-mix(in oklab, var(--accent-warm) 75%, transparent);
    stroke-width: 2;
    stroke-dasharray: 5 6;
    stroke-linecap: round;
  }
  .loop marker path {
    fill: none;
    stroke: var(--accent-warm);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .motto {
    margin-top: var(--space-6);
    font-family: 'Instrument Serif', Georgia, serif;
    font-style: italic;
    font-size: var(--step-3);
    color: var(--heading);
    letter-spacing: 0.005em;
  }
  .warm-word {
    color: var(--accent-warm);
  }

  /* phones: a vertical path, loop on the left */
  @media (max-width: 44rem) {
    .how {
      --node: 60px;
      text-align: left;
    }
    .head {
      justify-items: start;
    }
    .loop-wrap {
      padding: 0 0 0 40px;
      max-width: 22rem;
      margin-inline: 0;
    }
    .steps {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
    .step {
      grid-template-columns: var(--node) 1fr;
      align-items: center;
      justify-items: start;
    }
    .step:not(:last-child)::after {
      top: calc(var(--node) + 6px);
      bottom: calc(-1 * var(--space-5) + 6px);
      left: calc(var(--node) / 2 - 1px);
      right: auto;
      border-top: 0;
      border-left: 2px dotted color-mix(in oklab, var(--accent) 55%, transparent);
    }
    .label::after {
      margin-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .step:hover .node {
      transform: none;
    }
  }
</style>

<script>
  // Draw the Learn → Problem return path from the nodes' real positions,
  // so it wraps around the labels on any screen size.
  const R = 22;
  document.querySelectorAll<HTMLElement>('.how .loop-wrap').forEach((wrap) => {
    const path = wrap.querySelector<SVGPathElement>('.loop-path')!;
    const nodes = wrap.querySelectorAll<HTMLElement>('.node');
    const first = nodes[0];
    const last = nodes[nodes.length - 1];
    const firstLabel = first.parentElement!.querySelector<HTMLElement>('.label')!;

    const draw = () => {
      const w = wrap.getBoundingClientRect();
      const a = first.getBoundingClientRect();
      const b = last.getBoundingClientRect();
      const lab = firstLabel.getBoundingClientRect();
      const row = Math.abs(a.top - b.top) < 4; // all nodes on one line?

      if (row) {
        // out of Learn's right side, down, back left under the labels, up to Problem
        const sx = b.right - w.left + 6;
        const sy = b.top + b.height / 2 - w.top;
        const rx = sx + 26;
        const by = w.height - 4;
        const ex = a.left + a.width / 2 - w.left;
        const ey = lab.bottom - w.top + 14;
        path.setAttribute(
          'd',
          `M${sx} ${sy} H${rx - R} Q${rx} ${sy} ${rx} ${sy + R} V${by - R} Q${rx} ${by} ${rx - R} ${by} H${ex + R} Q${ex} ${by} ${ex} ${by - R} V${ey}`,
        );
      } else {
        // phones: out of Learn's left side, up the left edge, into Problem
        const sx = b.left - w.left - 6;
        const sy = b.top + b.height / 2 - w.top;
        const lx = 6;
        const ty = a.top + a.height / 2 - w.top;
        const ex = a.left - w.left - 8;
        path.setAttribute(
          'd',
          `M${sx} ${sy} H${lx + R} Q${lx} ${sy} ${lx} ${sy - R} V${ty + R} Q${lx} ${ty} ${lx + R} ${ty} H${ex}`,
        );
      }
    };

    draw();
    new ResizeObserver(draw).observe(wrap);
    document.fonts?.ready.then(draw);
  });
</script>
